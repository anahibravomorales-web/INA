<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>INA Pro - Strategic HR Partner</title>
  <meta name="theme-color" content="#3b0764">
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    /* Corrección de altura para pantallas móviles de celulares */
    html, body {
      height: 100%;
      height: -webkit-fill-available;
      overflow: hidden;
    }
  </style>
</head>
<body class="bg-slate-950 text-slate-100 flex flex-col h-screen w-screen m-0 p-0 font-sans select-none overflow-hidden">

  <!-- Encabezado Pro -->
  <header class="bg-gradient-to-r from-purple-950 via-purple-900 to-indigo-950 text-white p-3 flex items-center justify-between border-b border-purple-800/50 shadow-lg shrink-0">
    <div class="flex items-center gap-2">
      <div class="w-9 h-9 rounded-xl bg-gradient-to-tr from-purple-600 to-indigo-500 flex items-center justify-center font-black text-sm shadow-md">
        INA
      </div>
      <div>
        <h1 class="font-bold text-xs leading-tight">INA HR Pro</h1>
        <p class="text-[9px] text-purple-300/80">People Operations</p>
      </div>
    </div>
    <div class="flex gap-1.5">
      <button onclick="alternarModalKey()" class="text-[10px] font-bold bg-purple-800/60 hover:bg-purple-700 text-purple-200 px-2 py-1 rounded-lg border border-purple-600/40">
        🔑 Key
      </button>
      <button onclick="generarReporteJefe()" class="text-[10px] font-bold bg-indigo-800/60 hover:bg-indigo-700 text-indigo-200 px-2 py-1 rounded-lg border border-indigo-600/40">
        📊 Jefe
      </button>
    </div>
  </header>

  <!-- Modal para pegar la API Key sin bloqueos -->
  <div id="modal-key" class="hidden bg-slate-900 border-b border-purple-500/40 p-3 flex flex-col gap-2 shrink-0">
    <p class="text-[11px] text-purple-300 font-bold">🔑 Configurar tu API Key de Gemini:</p>
    <div class="flex gap-2">
      <input type="password" id="input-key" placeholder="Pega tu clave AI Studio aquí..." class="flex-1 bg-slate-950 border border-purple-800 rounded-lg px-2.5 py-1.5 text-xs text-slate-100 outline-none focus:border-purple-500">
      <button onclick="guardarKey()" class="bg-purple-600 text-white text-xs px-3 py-1.5 rounded-lg font-bold">Guardar</button>
    </div>
  </div>

  <!-- Navegación de Pestañas -->
  <div class="flex border-b border-purple-900/40 bg-slate-950 shrink-0">
    <button onclick="cambiarPestana('chat')" id="btn-chat" class="flex-1 py-2 text-xs font-bold border-b-2 border-purple-500 text-purple-300 bg-purple-950/20">
      💬 Chat IA
    </button>
    <button onclick="cambiarPestana('agenda')" id="btn-agenda" class="flex-1 py-2 text-xs font-bold text-slate-400">
      📋 Tablero
    </button>
    <button onclick="cambiarPestana('nomina')" id="btn-nomina" class="flex-1 py-2 text-xs font-bold text-slate-400">
      👥 Nómina
    </button>
  </div>

  <!-- VISTA CHAT -->
  <div id="vista-chat" class="flex-1 flex flex-col min-h-0 bg-slate-900/80">
    <div id="contenedor-mensajes" class="flex-1 overflow-y-auto p-3 space-y-3">
      <div class="flex justify-start">
        <div class="max-w-[90%] bg-slate-800/90 border border-purple-500/20 rounded-2xl rounded-bl-none p-3 text-xs text-slate-200 shadow-lg leading-relaxed">
          <p class="font-semibold text-purple-300 mb-1">💼 INA conectada a la Nómina de Planta.</p>
          Escribe o díctame el torbellino de novedades de tus recorridas. Las cruzaré con el personal registrado, los horarios y tus variables.
        </div>
      </div>
    </div>
    
    <!-- BARRA DE ENTRADA (Siempre visible) -->
    <div class="p-2.5 bg-slate-950 border-t border-purple-900/40 flex gap-2 items-center shrink-0">
      <input 
        type="text" 
        id="input-mensaje" 
        placeholder="Escribe o dicta tus novedades..." 
        onkeydown="if(event.key === 'Enter') enviarMensaje()"
        class="flex-1 bg-slate-900 border border-purple-900/60 rounded-xl px-3 py-2.5 text-xs text-slate-100 outline-none focus:border-purple-500 transition placeholder-slate-500"
      />
      <button onclick="enviarMensaje()" class="bg-purple-600 hover:bg-purple-500 text-white rounded-xl px-4 py-2.5 font-bold shadow-lg text-xs shrink-0">
        Enviar
      </button>
    </div>
  </div>

  <!-- VISTA TABLERO -->
  <div id="vista-agenda" class="flex-1 p-3 flex flex-col min-h-0 bg-slate-900/80 hidden">
    <div class="flex gap-1.5 overflow-x-auto pb-1.5 shrink-0">
      <button onclick="filtrarAgenda('todas')" id="f-todas" class="filtro-btn px-2.5 py-1 rounded-lg text-[10px] font-bold bg-purple-600 text-white">Todas</button>
      <button onclick="filtrarAgenda('alta')" id="f-alta" class="filtro-btn px-2.5 py-1 rounded-lg text-[10px] font-bold bg-slate-800 text-red-400 border border-red-900/40">🔴 Alta</button>
      <button onclick="filtrarAgenda('media')" id="f-media" class="filtro-btn px-2.5 py-1 rounded-lg text-[10px] font-bold bg-slate-800 text-yellow-400 border border-yellow-900/40">🟡 Media</button>
      <button onclick="filtrarAgenda('baja')" id="f-baja" class="filtro-btn px-2.5 py-1 rounded-lg text-[10px] font-bold bg-slate-800 text-green-400 border border-green-900/40">🟢 Baja</button>
    </div>
    <div id="lista-agenda" class="flex-1 overflow-y-auto space-y-2 mt-2 pr-1"></div>
  </div>

  <!-- VISTA NÓMINA -->
  <div id="vista-nomina" class="flex-1 p-3 flex flex-col overflow-y-auto min-h-0 bg-slate-900/80 hidden space-y-3">
    <div class="bg-slate-800/80 p-3 rounded-2xl border border-purple-900/40 shadow">
      <h3 class="text-xs font-bold text-purple-300 mb-2">➕ Cargar / Editar Empleado</h3>
      <div class="space-y-2 text-xs">
        <input type="text" id="nom-nombre" placeholder="Nombre completo" class="w-full bg-slate-900 border border-purple-900/50 rounded-lg p-2 text-slate-100 outline-none">
        <div class="flex gap-2">
          <input type="text" id="nom-legajo" placeholder="Legajo" class="w-1/2 bg-slate-900 border border-purple-900/50 rounded-lg p-2 text-slate-100 outline-none">
          <input type="text" id="nom-puesto" placeholder="Puesto / Sector" class="w-1/2 bg-slate-900 border border-purple-900/50 rounded-lg p-2 text-slate-100 outline-none">
        </div>
        <input type="text" id="nom-horarios" placeholder="Horarios / Turno habitual" class="w-full bg-slate-900 border border-purple-900/50 rounded-lg p-2 text-slate-100 outline-none">
        <input type="text" id="nom-variable" placeholder="Criterios de Variable / KPI" class="w-full bg-slate-900 border border-purple-900/50 rounded-lg p-2 text-slate-100 outline-none">
        <button onclick="guardarEmpleado()" class="w-full bg-purple-700 hover:bg-purple-600 text-white font-bold py-2 rounded-xl text-xs">
          Guardar Empleado
        </button>
      </div>
    </div>

    <div class="flex-1">
      <h3 class="text-xs font-bold text-slate-300 mb-2">📋 Personal Registrado</h3>
      <div id="lista-empleados" class="space-y-2 pb-4"></div>
    </div>
  </div>

  <script>
    let items = JSON.parse(localStorage.getItem('ina_rrhh_items')) || [];
    let empleados = JSON.parse(localStorage.getItem('ina_rrhh_empleados')) || [];
    let apiKey = localStorage.getItem('ina_gemini_api_key') || '';
    let filtroActual = 'todas';

    // Cargar Key existente al inicio
    if (apiKey) {
      document.getElementById('input-key').value = apiKey;
    }

    function alternarModalKey() {
      const modal = document.getElementById('modal-key');
      modal.classList.toggle('hidden');
    }

    function guardarKey() {
      const val = document.getElementById('input-key').value.trim();
      apiKey = val;
      localStorage.setItem('ina_gemini_api_key', apiKey);
      alert('🔑 Key guardada correctamente.');
      alternarModalKey();
    }

    function cambiarPestana(pestana) {
      document.getElementById('vista-chat').classList.add('hidden');
      document.getElementById('vista-agenda').classList.add('hidden');
      document.getElementById('vista-nomina').classList.add('hidden');
      
      document.getElementById('btn-chat').className = "flex-1 py-2 text-xs font-bold text-slate-400";
      document.getElementById('btn-agenda').className = "flex-1 py-2 text-xs font-bold text-slate-400";
      document.getElementById('btn-nomina').className = "flex-1 py-2 text-xs font-bold text-slate-400";

      if (pestana === 'chat') {
        document.getElementById('vista-chat').classList.remove('hidden');
        document.getElementById('btn-chat').className = "flex-1 py-2 text-xs font-bold border-b-2 border-purple-500 text-purple-300 bg-purple-950/20";
      } else if (pestana === 'agenda') {
        document.getElementById('vista-agenda').classList.remove('hidden');
        document.getElementById('btn-agenda').className = "flex-1 py-2 text-xs font-bold border-b-2 border-purple-500 text-purple-300 bg-purple-950/20";
        renderAgenda();
      } else {
        document.getElementById('vista-nomina').classList.remove('hidden');
        document.getElementById('btn-nomina').className = "flex-1 py-2 text-xs font-bold border-b-2 border-purple-500 text-purple-300 bg-purple-950/20";
        renderNomina();
      }
    }

    function guardarEmpleado() {
      const nombre = document.getElementById('nom-nombre').value.trim();
      const legajo = document.getElementById('nom-legajo').value.trim();
      const puesto = document.getElementById('nom-puesto').value.trim();
      const horarios = document.getElementById('nom-horarios').value.trim();
      const variable = document.getElementById('nom-variable').value.trim();

      if (!nombre) { alert('Ingresa al menos el nombre.'); return; }

      const emp = { id: Date.now(), nombre, legajo, puesto, horarios, variable };
      empleados.push(emp);
      localStorage.setItem('ina_rrhh_empleados', JSON.stringify(empleados));
      
      document.getElementById('nom-nombre').value = '';
      document.getElementById('nom-legajo').value = '';
      document.getElementById('nom-puesto').value = '';
      document.getElementById('nom-horarios').value = '';
      document.getElementById('nom-variable').value = '';

      renderNomina();
    }

    function renderNomina() {
      const contenedor = document.getElementById('lista-empleados');
      if (empleados.length === 0) {
        contenedor.innerHTML = `<p class="text-slate-500 text-xs py-4 text-center">No hay personal cargado aún.</p>`;
        return;
      }
      contenedor.innerHTML = empleados.map(e => `
        <div class="bg-slate-800 p-2.5 rounded-xl border border-purple-900/30 flex justify-between items-start text-xs">
          <div>
            <p class="font-bold text-purple-300">${e.nombre} <span class="text-slate-400 font-normal">(${e.puesto || 'Sin Puesto'})</span></p>
            <p class="text-[10px] text-slate-400">Legajo: ${e.legajo \vert{}\vert{} 'S/D'} \vert{} Horario:${e.horarios || 'S/D'}</p>
            <p class="text-[10px] text-slate-300 mt-1">KPI: ${e.variable || 'Sin especificación'}</p>
          </div>
          <button onclick="eliminarEmpleado(${e.id})" class="text-red-400 text-xs font-bold">✕</button>
        
