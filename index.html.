<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>INA - Tu Asistente Personal</title>
  
  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  
  <!-- React & React DOM -->
  <script crossorigin src="https://unpkg.com/react@18/umd/react.production.min.js"></script>
  <script crossorigin src="https://unpkg.com/react-dom@18/umd/react-dom.production.min.js"></script>
  
  <!-- Babel para transpilar JSX -->
  <script src="https://unpkg.com/@babel/standalone/babel.min.min.js"></script>
  
  <!-- Lucide Icons -->
  <script src="https://unpkg.com/lucide@latest"></script>
  
  <style>
    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      background-color: #f3f4f6;
      -webkit-tap-highlight-color: transparent;
    }
    .chat-scroll::-webkit-scrollbar {
      width: 4px;
    }
    .chat-scroll::-webkit-scrollbar-thumb {
      background-color: #cbd5e1;
      border-radius: 4px;
    }
  </style>
</head>
<body class="h-screen w-screen overflow-hidden bg-gray-100 text-gray-800">
  <div id="root" class="h-full w-full"></div>

  <script type="text/babel">
    const { useState, useEffect, useRef } = React;

    // Componente principal de la aplicación INA
    function App() {
      const [messages, setMessages] = useState(() => {
        const saved = localStorage.getItem('ina_messages');
        return saved ? JSON.parse(saved) : [
          {
            id: 1,
            sender: 'ina',
            text: '¡Hola! Soy **INA**, tu asistente personal. Podés escribirme cualquier novedad, tarea, problema u observación como si me hablaras por WhatsApp. Yo me me encargo de clasificarlo y recordártelo.',
            timestamp: new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })
          }
        ];
      });

      const [inputText, setInputText] = useState('');
      const [activeTab, setActiveTab] = useState('chat'); // 'chat' o 'agenda'
      const [agendaFilter, setAgendaFilter] = useState('hoy'); // 'hoy', 'proximos', 'pendientes', 'seguimiento', 'espera', 'completadas'
      const [apiKey, setApiKey] = useState(() => localStorage.getItem('ina_gemini_api_key') || '');
      const [showSettings, setShowSettings] = useState(false);

      const [items, setItems] = useState(() => {
        const saved = localStorage.getItem('ina_items');
        return saved ? JSON.parse(saved) : [
          {
            id: '1',
            text: 'Liquidación: Juan Pérez llegó tarde porque se le pinchó la moto',
            categoria: 'Novedad',
            persona: 'Juan Pérez',
            area: 'Liquidaciones',
            fecha: new Date().toISOString().split('T')[0],
            estado: 'hoy',
            confirmado: true
          },
          {
            id: '2',
            text: 'Desempeño: observar a Facundo, viene teniendo dificultades',
            categoria: 'Observación',
            persona: 'Facundo',
            area: 'Desempeño',
            fecha: new Date().toISOString().split('T')[0],
            estado: 'seguimiento',
            confirmado: true
          },
          {
            id: '3',
            text: 'Falta realizar la denuncia administrativa por el accidente de Luis',
            categoria: 'Problema',
            persona: 'Luis',
            area: 'Administración',
            fecha: new Date().toISOString().split('T')[0],
            estado: 'pendientes',
            confirmado: true
          }
        ];
      });

      const chatEndRef = useRef(null);

      useEffect(() => {
        localStorage.setItem('ina_messages', JSON.stringify(messages));
      }, [messages]);

      useEffect(() => {
        localStorage.setItem('ina_items', JSON.stringify(items));
      }, [items]);

      useEffect(() => {
        localStorage.setItem('ina_gemini_api_key', apiKey);
      }, [apiKey]);

      useEffect(() => {
        chatEndRef.current?.scrollIntoView({ behavior: 'smooth' });
      }, [messages]);

      // Función simple para interpretar y clasificar texto
      const clasificarTexto = (texto) => {
        const textLower = texto.toLowerCase();
        let categoria = 'Novedad';
        let estado = 'hoy';

        if (textLower.includes('tengo que') || textLower.includes('comprar') || textLower.includes('falta') || textLower.includes('hacer')) {
          categoria = 'Tarea';
          estado = 'pendientes';
        } else if (textLower.includes('observar') || textLower.includes('dificultades')) {
          categoria = 'Observación';
          estado = 'seguimiento';
        } else if (textLower.includes('accidente') || textLower.includes('problema') || textLower.includes('urgente')) {
          categoria = 'Problema';
          estado = 'pendientes';
        } else if (textLower.includes('idea') || textLower.includes('propuesta')) {
          categoria = 'Idea';
          estado = 'espera';
        }

        // Extraer nombres comunes si los encuentra
        const personasPosibles = ['Juan Pérez', 'Facundo', 'Luis', 'Matías', 'Juan', 'Pedro', 'María'];
        const persona = personasPosibles.find(p => textLower.includes(p.toLowerCase())) || 'No especificada';

        return { categoria, estado, persona };
      };

      const handleSendMessage = () => {
        if (!inputText.trim()) return;

        const userMsg = {
          id: Date.now(),
          sender: 'user',
          text: inputText,
          timestamp: new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })
        };

        const newMessages = [...messages, userMsg];
        setMessages(newMessages);
        const textToProcess = inputText;
        setInputText('');

        // Simular respuesta de INA
        setTimeout(() => {
          const datos = clasificarTexto(textToProcess);
          const newItem = {
            id: Date.now().toString(),
            text: textToProcess,
            categoria: datos.categoria,
            persona: datos.persona,
            area: 'General',
            fecha: new Date().toISOString().split('T')[0],
            estado: datos.estado,
            confirmado: true
          };

          setItems(prev => [newItem, ...prev]);

          const inaMsg = {
            id: Date.now() + 1,
            sender: 'ina',
            text: `Registré tu nota como **${datos.categoria}**${datos.persona !== 'No especificada' ? ` asociada a **${datos.persona}**` : ''}. Quedó guardada en tu sección de **${datos.estado.toUpperCase()}**.`,
            timestamp: new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })
          };

          setMessages(prev => [...prev, inaMsg]);
        }, 600);
      };

      return (
        <div className="flex flex-col h-full max-w-md mx-auto bg-white shadow-xl relative">
          {/* Encabezado */}
          <header className="bg-emerald-600 text-white p-4 flex justify-between items-center shadow-md">
            <div className="flex items-center space-x-3">
              <div className="w-10 h-10 rounded-full bg-emerald-800 flex items-center justify-center font-bold text-lg border-2 border-emerald-300">
                INA
              </div>
              <div>
                <h1 className="font-bold text-lg leading-tight">INA</h1>
                <p className="text-xs text-emerald-100">Tu Asistente Personal</p>
              </div>
            </div>
            <button 
              onClick={() => setShowSettings(!showSettings)}
              className="p-2 rounded-full hover:bg-emerald-700 transition"
            >
              ⚙️
            </button>
          </header>

          {/* Modal Configuración Key */}
          {showSettings && (
            <div className="absolute top-16 right-4 left-4 bg-white border border-gray-300 rounded-lg shadow-2xl p-4 z-50">
              <h3 className="font-bold text-gray-800 mb-2">Configuración de INA</h3>
              <p className="text-xs text-gray-600 mb-3">
                Si tenés una clave de API de Google Gemini (opcional), pegala acá para hacer a INA aún más inteligente:
              </p>
              <input 
                type="password"
                placeholder="Clave de API de Gemini"
                value={apiKey}
                onChange={(e) => setApiKey(e.target.value)}
                className="w-full border p-2 text-sm rounded mb-3"
              />
              <div className="flex justify-between items-center">
                <a href="https://aistudio.google.com/" target="_blank" rel="noreferrer" className="text-xs text-emerald-600 font-semibold underline">
                  Obtener clave gratis
                </a>
                <button 
                  onClick={() => setShowSettings(false)}
                  className="bg-emerald-600 text-white text-xs px-3 py-1.5 rounded font-medium"
                >
                  Guardar y Cerrar
                </button>
              </div>
            </div>
          )}

          {/* Navegación por Pestañas */}
          <div className="flex border-b border-gray-200 bg-gray-50">
            <button 
              onClick={() => setActiveTab('chat')} 
              className={`flex-1 py-3 text-center text-sm font-semibold transition ${activeTab === 'chat' ? 'border-b-2 border-emerald-600 text-emerald-600 bg-white' : 'text-gray-500'}`}
            >
              💬 Chat con INA
            </button>
            <button 
              onClick={() => setActiveTab('agenda')} 
              className={`flex-1 py-3 text-center text-sm font-semibold transition ${activeTab === 'agenda' ? 'border-b-2 border-emerald-600 text-emerald-600 bg-white' : 'text-gray-500'}`}
            >
              📋 Agenda ({items.length})
            </button>
          </div>

          {/* VISTA 1: CHAT */}
          {activeTab === 'chat' && (
            <div className="flex-1 flex flex-col justify-between overflow-hidden bg-slate-50">
              <div className="flex-1 overflow-y-auto p-4 space-y-3 chat-scroll">
                {messages.map((msg) => (
                  <div key={msg.id} className={`flex ${msg.sender === 'user' ? 'justify-end' : 'justify-start'}`}>
                    <div className={`max-w-[85%] rounded-2xl px-4 py-2.5 text-sm shadow-sm ${
                      msg.sender === 'user' 
                        ? 'bg-emerald-600 text-white rounded-br-none' 
                        : 'bg-white text-gray-800 border border-gray-100 rounded-bl-none'
                    }`}>
                      <p className="whitespace-pre-line">{msg.text}</p>
                      <span className={`text-[10px] block text-right mt-1 ${msg.sender === 'user' ? 'text-emerald-200' : 'text-gray-400'}`}>
                        {msg.timestamp}
                      </span>
                    </div>
                  </div>
                ))}
                <div ref={chatEndRef} />
              </div>

              {/* Caja para escribir */}
              <div className="p-3 bg-white border-t border-gray-200 flex items-center gap-2">
                <input 
                  type="text" 
                  placeholder="Escribile a INA..."
                  value={inputText}
                  onChange={(e) => setInputText(e.target.value)}
                  onKeyDown={(e) => e.key === 'Enter' && handleSendMessage()}
                  className="flex-1 border border-gray-300 rounded-full px-4 py-2 text-sm focus:outline-none focus:border-emerald-600"
                />
                <button 
                  onClick={handleSendMessage}
                  className="bg-emerald-600 text-white rounded-full p-2.5 hover:bg-emerald-700 transition"
                >
                  ➔
                </button>
              </div>
            </div>
          )}

          {/* VISTA 2: AGENDA */}
          {activeTab === 'agenda' && (
            <div className="flex-1 flex flex-col overflow-hidden bg-gray-50 p-3">
              {/* Filtros de la Agenda */}
              <div className="flex overflow-x-auto gap-2 pb-2 mb-2 no-scrollbar">
                {['hoy', 'proximos', 'pendientes', 'seguimiento', 'espera', 'completadas'].map((f) => (
                  <button
                    key={f}
                    onClick={() => setAgendaFilter(f)}
                    className={`px-3 py-1 rounded-full text-xs capitalize whitespace-nowrap border ${
                      agendaFilter === f 
                        ? 'bg-emerald-600 text-white border-emerald-600 font-bold' 
                        : 'bg-white text-gray-600 border-gray-300'
                    }`}
                  >
                    {f}
                  </button>
                ))}
              </div>

              {/* Lista de Registros */}
              <div className="flex-1 overflow-y-auto space-y-2 pr-1">
                {items.filter(i => i.estado === agendaFilter).length === 0 ? (
                  <div className="text-center py-8 text-gray-400 text-sm">
                    No hay nada anotado en "{agendaFilter}"
                  </div>
                ) : (
                  items.filter(i => i.estado === agendaFilter).map((item) => (
                    <div key={item.id} className="bg-white p-3 rounded-lg border border-gray-200 shadow-sm flex flex-col gap-1">
                      <div className="flex justify-between items-start">
                        <span className="text-[11px] font-bold px-2 py-0.5 rounded bg-emerald-100 text-emerald-800">
                          {item.categoria}
                        </span>
                        <span className="text-[10px] text-gray-400">{item.fecha}</span>
                      </div>
                      <p className="text-sm font-medium text-gray-800">{item.text}</p>
                      {item.persona !== 'No especificada' && (
                        <span className="text-xs text-emerald-600">👤 {item.persona}</span>
                      )}
                    </div>
                  ))
                )}
              </div>
            </div>
          )}
        </div>
      );
    }

    ReactDOM.createRoot(document.getElementById('root')).render(<App />);
  </script>
</body>
</html>
